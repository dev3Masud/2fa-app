# =============================================================
# 2FA Vault - Environment Variables
#
# For Vercel: set these in the Vercel dashboard
#   Project Settings -> Environment Variables
#
# For local dev: copy this file to .env and fill in values
# =============================================================

# Required: signs the JWT session cookie. Any 32+ char random string.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required: admin credentials. Must be set - the app will refuse to
# start without them. The first successful login bootstraps the user
# row in Supabase with these credentials.
ADMIN_USER=
ADMIN_PASS=

# Required: Supabase project credentials.
# Get these from https://app.supabase.com -> Project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
